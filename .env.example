# ---- App ----------------------------------------------------------------
# development | production | test. production enforces API_KEYS + Postgres + provider creds.
APP_ENV=development
# Python log level.
LOG_LEVEL=INFO
# true = JSON lines (for log shippers); false = human-readable console output.
LOG_JSON=true
# Expose Prometheus metrics at GET /metrics.
METRICS_ENABLED=false

# ---- Auth ---------------------------------------------------------------
# Comma-separated keys accepted in the X-API-Key header. Required in production.
# Empty in development = auth disabled (logged at startup). Rotate by listing old,new then
# dropping old.
API_KEYS=

# ---- Persistence --------------------------------------------------------
# SQLAlchemy URL. Postgres in prod: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./lead_agent.db

# ---- LLM ----------------------------------------------------------------
# Required only for live Claude calls. Tests and the default eval use FakeLLM.
ANTHROPIC_API_KEY=
# claude | fake. With "claude" and no key the server falls back to FakeLLM.
LEAD_AGENT_LLM=claude
# Model id for classification and drafting.
LEAD_AGENT_MODEL=claude-sonnet-5-5
# Per-call HTTP timeout and retry budget (tenacity, exponential backoff with jitter).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# USD per million tokens, used for the cost_usd field in llm.usage logs.
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=10.0

# ---- Inbound webhooks ---------------------------------------------------
# POST /webhooks/twilio (form-encoded, X-Twilio-Signature verified with the auth token).
TWILIO_WEBHOOK_ENABLED=false
TWILIO_AUTH_TOKEN=
# Public URL Twilio was configured with, if the app is behind a proxy that rewrites Host.
TWILIO_WEBHOOK_URL=
# POST /webhooks/sendgrid?token=... (Inbound Parse multipart). Not signed by SendGrid, so a
# shared secret in the query string is required.
SENDGRID_WEBHOOK_ENABLED=false
SENDGRID_INBOUND_SECRET=

# ---- Outbound replies ---------------------------------------------------
# dry_run = record only (default, safe). live = Twilio SMS + SendGrid email.
OUTBOUND_MODE=dry_run
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Comma-separated categories whose send_reply executes without approval, e.g. pricing,availability.
# Escalated threads are never auto-sent. Leave empty until a trust period has passed.
AUTO_SEND_CATEGORIES=
